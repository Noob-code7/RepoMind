# Normalize line endings to LF on commit; check out LF everywhere.
# Fixes phantom "modified" files when the repo is accessed from both
# Windows git and WSL/Linux git (VS Code Remote-WSL).
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
