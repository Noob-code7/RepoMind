{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "orchestrator/**/*.ts",
    "agents/**/*.ts",
    "human_gate/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "ui/**/*.tsx",
    "ui/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "generated_projects"]
}
