# Braid — environment template. Copy to .env and fill in keys.
# Plan and Review MUST be different model families to reduce correlated blind spots.
# 2026-09-25 notes: deepseek-reasoner/deepseek-chat return 402 when out of
# credit; gemini-2.5-* is sunset (404, use gemini-3.x/gemma-4);
# nvidia/llama-3.1-nemotron-70b-instruct is retired (404, use
# nvidia/nemotron-3-ultra-550b-a55b). All defaults below are verified live
# via the single funded OPENROUTER_API_KEY.

# Reasoning-adjacent model for Planning (JSON-clean; keep family != review)
PLAN_MODEL=google/gemma-4-26b-a4b-it
PLAN_API_KEY=
# Architecturally distinct model for Review (Nvidia vs Google above)
REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b
REVIEW_API_KEY=

# Agentic coding model for Execute (skeleton + implementation passes)
EXECUTE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
EXECUTE_API_KEY=

# Lightweight triage + summarization models
TRIAGE_MODEL=nvidia/nemotron-3.5-lightning
TRIAGE_API_KEY=
REPORT_MODEL=google/gemma-4-26b-a4b-it
REPORT_API_KEY=

# Generic fallbacks (used when stage-specific key is empty).
# OPENROUTER_API_KEY is checked first for every stage.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Orchestrator controls
MAX_SELF_LOOP_ITERATIONS=3
GENERATED_ROOT=./generated_projects

# Tiger Data / TimescaleDB Real-time Telemetry & Analytics
# Connection string to Tiger Data / TimescaleDB instance:
# e.g., postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
TIGER_DATABASE_URL=
# Enable or disable real-time telemetry streaming (defaults to false if TIGER_DATABASE_URL is unset)
TIGER_TELEMETRY_ENABLED=true
# Batch size for high-throughput micro-batch event ingestion
TIGER_BATCH_SIZE=20
# Flush interval in milliseconds for telemetry queue
TIGER_FLUSH_INTERVAL_MS=500

